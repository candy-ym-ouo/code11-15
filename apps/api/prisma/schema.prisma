generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  sysadmin
  user
}

enum AccountStatus {
  active
  disabled
}

enum FamilyRole {
  owner
  admin
  editor
  contributor
  viewer
}

enum MemberStatus {
  active
  disabled
}

enum Category {
  furniture
  souvenir
  receipt
  manuscript
  other
}

enum ItemStatus {
  draft
  published
  archived
  trashed
}

enum Visibility {
  private
  family
  selected
  link
}

enum Precision {
  day
  month
  year
  decade
  unknown
}

enum MediaKind {
  image
  audio
  document
}

enum MediaStatus {
  processing
  ready
  failed
}

enum NoteType {
  story
  comment
  correction
}

enum NoteStatus {
  pending
  accepted
  rejected
}

enum PersonRole {
  source
  gifted
  inherited
  owner
  mentioned
}

enum Gender {
  unknown
  male
  female
}

enum KinEdgeType {
  parent
  partner
  sibling
}

enum KinEdgeOrigin {
  manual
  inferred
}

enum KinConfidence {
  high
  medium
  low
}

enum KinIssueStatus {
  open
  ignored
  resolved
}

enum JobType {
  media_thumbnail
  media_waveform
  export_build
  trash_purge
  storage_gc
}

enum JobStatus {
  queued
  running
  done
  failed
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String        @map("display_name")
  avatarColor  String        @default("#2F4858") @map("avatar_color")
  systemRole   SystemRole    @default(user) @map("system_role")
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  memberships   FamilyMember[]
  items         Item[]
  notes         ItemNote[]
  versions      ItemVersion[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  kinshipVersions KinshipVersion[] @relation("KinshipVersionCreator")

  @@map("users")
}

model Family {
  id                   String     @id @default(cuid())
  name                 String
  description          String?
  defaultVisibility    Visibility @default(family) @map("default_visibility")
  allowViewerComment   Boolean    @default(false) @map("allow_viewer_comment")
  kinshipAnchorPersonId String?  @map("kinship_anchor_person_id")
  createdBy            String     @map("created_by")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  members    FamilyMember[]
  invites    Invite[]
  people     Person[]
  items      Item[]
  shareLinks ShareLink[]
  auditLogs  AuditLog[]
  settings   Setting[]
  kinshipEdges KinshipEdge[]
  kinshipVersions KinshipVersion[]
  kinshipIssues KinshipIssue[]

  @@map("families")
}

model FamilyMember {
  id       String       @id @default(cuid())
  familyId String       @map("family_id")
  userId   String       @map("user_id")
  role     FamilyRole
  status   MemberStatus @default(active)
  joinedAt DateTime     @default(now()) @map("joined_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

model Invite {
  id        String    @id @default(cuid())
  familyId  String    @map("family_id")
  codeHash  String    @unique @map("code_hash")
  role      FamilyRole
  note      String?
  expiresAt DateTime  @map("expires_at")
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@map("invites")
}

model Person {
  id            String    @id @default(cuid())
  familyId      String    @map("family_id")
  name          String
  gender        Gender    @default(unknown)
  relation      String?
  birthYear     Int?      @map("birth_year")
  deathYear     Int?      @map("death_year")
  bio           String?
  avatarMediaId String?   @map("avatar_media_id")
  mergedIntoId  String?   @map("merged_into_id")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  links  ItemPerson[]

  // 关系图谱：以本人为两端的边（删除人物时一并删除，避免悬挂边）
  edgesFrom KinshipEdge[] @relation("KinEdgeFrom")
  edgesTo   KinshipEdge[] @relation("KinEdgeTo")

  @@index([familyId, name])
  @@map("people")
}

// 关系图谱的边。只有三种基础关系：
// parent 有方向（from 是 to 的父母）；partner / sibling 对称。
// 祖辈、叔侄、表亲等不落库，查询时沿边推导。
model KinshipEdge {
  id           String          @id @default(cuid())
  familyId     String          @map("family_id")
  fromPersonId String          @map("from_person_id")
  toPersonId   String          @map("to_person_id")
  type         KinEdgeType
  origin       KinEdgeOrigin   @default(manual)
  confidence   KinConfidence   @default(high)
  confirmed    Boolean         @default(true)
  note         String?
  evidence     Json?
  createdBy    String          @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson Person @relation("KinEdgeFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person @relation("KinEdgeTo", fields: [toPersonId], references: [id], onDelete: Cascade)

  // 唯一性靠应用层查重 + 迁移里的部分唯一索引（仅 deleted_at IS NULL），
  // 因为 Prisma 的 @@unique 不支持带条件，而我们要允许「删除后重建」同一段关系。
  @@index([fromPersonId, toPersonId, type])
  @@index([familyId, type])
  @@index([toPersonId])
  @@map("kinship_edges")
}

// 图谱版本：每次人工校正/推导采纳/回滚前，把当时的全量人物+边冻结成 JSON 快照。
// 回滚 = 读出快照整体重建边集合。人物本身的增删仍走人物模块，这里只管「关系」。
model KinshipVersion {
  id          String   @id @default(cuid())
  familyId    String   @map("family_id")
  version     Int
  reason      String?
  snapshot    Json
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User   @relation("KinshipVersionCreator", fields: [createdBy], references: [id])

  @@unique([familyId, version])
  @@index([familyId, createdAt])
  @@map("kinship_versions")
}

// 矛盾记录：检测出的结构/事实问题。fingerprint 是问题内容的哈希，
// 同一问题反复检测不会重复插库；用户「忽略」后再次出现也保持忽略。
model KinshipIssue {
  id          String         @id @default(cuid())
  familyId    String         @map("family_id")
  fingerprint String
  kind        String
  severity    String
  message     String
  edgeIds     String[]       @map("edge_ids")
  personIds   String[]       @map("person_ids")
  status      KinIssueStatus @default(open)
  ignoredBy   String?        @map("ignored_by")
  ignoredAt   DateTime?      @map("ignored_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, fingerprint])
  @@index([familyId, status])
  @@map("kinship_issues")
}

model Item {
  id                String     @id @default(cuid())
  familyId          String     @map("family_id")
  title             String
  category          Category
  status            ItemStatus @default(draft)
  visibility        Visibility @default(family)
  acquiredAt        DateTime?  @map("acquired_at")
  acquiredPrecision Precision  @default(unknown) @map("acquired_precision")
  acquiredLabel     String?    @map("acquired_label")
  acquiredNote      String?    @map("acquired_note")
  placeText         String?    @map("place_text")
  placeCity         String?    @map("place_city")
  placeProvince     String?    @map("place_province")
  placeCountry      String?    @map("place_country")
  placeLat          Decimal?   @map("place_lat") @db.Decimal(9, 6)
  placeLng          Decimal?   @map("place_lng") @db.Decimal(9, 6)
  storyHtml         String?    @map("story_html")
  storyText         String?    @map("story_text")
  condition         String?
  storageLocation   String?    @map("storage_location")
  tags              String[]   @default([])
  coverMediaId      String?    @map("cover_media_id")
  sortAt            DateTime   @map("sort_at")
  createdBy         String     @map("created_by")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  family  Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User         @relation(fields: [createdBy], references: [id])
  people  ItemPerson[]
  media   ItemMedia[]
  notes   ItemNote[]
  shares  ItemShare[]
  versions ItemVersion[]
  shareLinks ShareLinkItem[]

  @@index([familyId, status, category])
  @@index([familyId, sortAt])
  @@index([familyId, updatedAt])
  @@map("items")
}

model ItemPerson {
  id       String     @id @default(cuid())
  itemId   String     @map("item_id")
  personId String     @map("person_id")
  role     PersonRole @default(source)

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([itemId, personId, role])
  @@index([personId])
  @@map("item_people")
}

model ItemMedia {
  id          String      @id @default(cuid())
  itemId      String      @map("item_id")
  kind        MediaKind
  status      MediaStatus @default(processing)
  storageKey  String      @map("storage_key")
  sha256      String
  mimeType    String      @map("mime_type")
  byteSize    BigInt      @map("byte_size")
  width       Int?
  height      Int?
  durationMs  Int?        @map("duration_ms")
  thumbKey    String?     @map("thumb_key")
  largeKey    String?     @map("large_key")
  transcodeKey String?    @map("transcode_key")
  waveformKey String?     @map("waveform_key")
  originalName String     @map("original_name")
  caption     String?
  transcript  String?
  sortOrder   Int         @default(0) @map("sort_order")
  lastError   String?     @map("last_error")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  deletedAt   DateTime?   @map("deleted_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@index([sha256])
  @@map("item_media")
}

model ItemNote {
  id           String     @id @default(cuid())
  itemId       String     @map("item_id")
  authorId     String     @map("author_id")
  type         NoteType   @default(story)
  body         String
  status       NoteStatus @default(pending)
  rejectReason String?    @map("reject_reason")
  decidedBy    String?    @map("decided_by")
  decidedAt    DateTime?  @map("decided_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([itemId, createdAt])
  @@map("item_notes")
}

model ItemShare {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  canEdit   Boolean  @default(false) @map("can_edit")
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("item_shares")
}

model ItemVersion {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  version   Int
  snapshot  Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  item    Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@unique([itemId, version])
  @@map("item_versions")
}

model ShareLink {
  id           String    @id @default(cuid())
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  passwordHash String?   @map("password_hash")
  label        String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  accessCount  Int       @default(0) @map("access_count")
  lastAccessAt DateTime? @map("last_access_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  family Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items  ShareLinkItem[]

  @@index([familyId, createdAt])
  @@map("share_links")
}

model ShareLinkItem {
  shareLinkId String @map("share_link_id")
  itemId      String @map("item_id")

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([shareLinkId, itemId])
  @@map("share_link_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  familyId   String?  @map("family_id")
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  diff       Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  actor  User    @relation(fields: [actorId], references: [id])

  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Job {
  id          String    @id @default(cuid())
  familyId    String?   @map("family_id")
  type        JobType
  payload     Json
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  progress    Int       @default(0)
  result      Json?
  lastError   String?   @map("last_error")
  runAfter    DateTime  @default(now()) @map("run_after")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("jobs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Setting {
  familyId  String   @map("family_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([familyId, key])
  @@map("settings")
}
